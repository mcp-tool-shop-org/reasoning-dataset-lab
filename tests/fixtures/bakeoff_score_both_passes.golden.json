  "decision_rule_applied": false,
  "definitions": {
    "auroc": "AUROC of the mean of the two orders' P(yes): p_bar_i = 0.5 * (P_AB(yes) + P_BA(yes)) against binary ground truth (supported=1, not_supported=0); N/A for Flow-Judge",
    "invalid_output_rule": "an invalid output (unparseable or length_stop) scores P(yes) = 0.5 for AUROC and counts wrong for accuracy, and counts as a flip in flip_rate (strict_ceiling = 1 - flip_rate)",
    "p_yes": "yes-variant mass / (yes + no variant mass) from what is stored at the decision position (inverted for Granite Guardian; system_one noul readout for d3-mini)",
    "per_negative_class_precision": "TP / (TP + 2*FP_c) for each negative class c in {unsupported, cannot_tell}, meaning the precision the judge would have if the other negative class failed as badly as this one (>= 0.85 point estimate)",
    "screening_lcb": "one-sided 95% lower confidence bound (lcb = 5th percentile) of the domain-stratified triad bootstrap (10,000 resamples, seed 20261030) on AND-gate precision and recall (intersection-union, no multiplicity correction)",
    "tost_holm_adjusted_across_10_pairs": true,
    "tost_statistic": "paired triad-level TOST at +-SESOI (+-0.04) on triad strict-accuracy differences d_t = a_t - b_t using the unbiased sample variance estimator s_d^2 = (1/(T-1)) * sum((d_t - d_bar)^2) and SE = sqrt(s_d^2 / T)",
    "tost_variance_estimator": "unbiased_paired_triad_sample_variance_ddof1",
    "winner_selection_rule": "floors first over all judges that ran (failed_to_run never eligible): LCB(precision) >= 0.86, LCB(recall) >= 0.45, per-negative-class precision TP / (TP + 2*FP_c) >= 0.85 for unsupported and cannot_tell, and AND-gate recall >= 0.25 in at least 8 of 10 domains; Holm candidate set formed among eligible judges only relative to highest class_balanced_strict_accuracy eligible judge B (including practically_equivalent pairs); within PRECISION_BAND = 0.015 of best candidate point precision, pick highest class_balanced_strict_accuracy (differences < CB_TIE = 0.01 are ties), then smaller parameter count, then lower median latency; otherwise no_judge_eligible"
  },
